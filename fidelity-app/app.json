{
  "expo": {
    "name": "UP Fidelity",
    "slug": "fidelity-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fidelitepro.app"
    },
    "android": {
      "package": "com.fidelitepro.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser l'accès à la caméra pour scanner les QR codes clients."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffb800"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "fidelitepro"
  }
}