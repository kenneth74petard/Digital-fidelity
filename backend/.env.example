PORT=3000
NODE_ENV=development

# API security
# Option A (single global token, requires x-restaurant-id on each /api call)
ADMIN_API_TOKEN=change-me
# Option B (recommended): commerce-scoped tokens "restaurantId:token,restaurantId:token"
# ADMIN_API_TOKENS=resto_a:token_a,resto_b:token_b

# CORS (comma-separated origins). Leave empty in local dev to allow all origins.
ALLOWED_ORIGINS=

# Rate limit for /api routes (requests per 15 minutes per IP)
RATE_LIMIT_MAX=300

# Live mode toggles
WALLET_LIVE_MODE=false
PUSH_LIVE_MODE=false

# SQLite database path
DB_PATH=./fidelity.db

# VAPID keys for Web Push (auto-generated on first run)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=mailto:contact@yourcommerce.com

# TODO [PRODUCTION]: Apple Developer credentials
# APPLE_TEAM_ID=
# APPLE_PASS_TYPE_ID=pass.com.yourcommerce.fidelite
# APPLE_KEY_PATH=./certs/pass.key
# APPLE_CERT_PATH=./certs/pass.pem
# APPLE_WWDR_PATH=./certs/wwdr.pem

# TODO [PRODUCTION]: APNs (Apple Push Notification service)
# APNS_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=pass.com.yourcommerce.fidelite
