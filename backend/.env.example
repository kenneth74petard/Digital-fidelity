PORT=3000
NODE_ENV=development

# Simulation mode: when true, skip real Apple signing and real push notifications
SIMULATION_MODE=true

# SQLite database path
DB_PATH=./fidelity.db

# VAPID keys for Web Push (auto-generated on first run)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=mailto:contact@yourrestaurant.com

# TODO [PRODUCTION]: Apple Developer credentials
# APPLE_TEAM_ID=
# APPLE_PASS_TYPE_ID=pass.com.yourrestaurant.fidelite
# APPLE_KEY_PATH=./certs/pass.key
# APPLE_CERT_PATH=./certs/pass.pem
# APPLE_WWDR_PATH=./certs/wwdr.pem

# TODO [PRODUCTION]: APNs (Apple Push Notification service)
# APNS_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=pass.com.yourrestaurant.fidelite
